<%-
  # Launch Jupyter in the Cirrus Kubernetes cluster. The ood-k8s-utils init
  # containers below set a one-time password and the reverse-proxy base_url in
  # the notebook config before Jupyter starts.
  configmap_filename = "ondemand_config.py"
  # Public mirror of OSC's helper image. Pin a real tag before production use.
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new
-%>
---
script:
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    container:
      name: "jupyter"
      image: "hub.k8s.ucar.edu/cirrus-jhub/jhub-cpu-nb:0.1.5"
      command: "jupyter notebook --config=/ood/ondemand_config.py"
      working_dir: "<%= user.home %>"
      restart_policy: "OnFailure"
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
      volume_mounts:
        - name: "home"
          mount_path: "<%= user.home %>"
    volumes:
      - name: "home"
        nfs:
          server: "gladenfs.hpc.ucar.edu"
          path: "<%= user.home %>"
    configmap:
      files:
        - filename: "<%= configmap_filename %>"
          data: |
            c.NotebookApp.port = 8080
            c.NotebookApp.ip = '0.0.0.0'
            c.NotebookApp.disable_check_xsrf = True
            c.NotebookApp.allow_origin = '*'
            c.Application.log_level = 'DEBUG'
          mount_path: "/ood"
    init_containers:
      # The `Q=$(printf '\\\\047')` below builds a single quote at runtime: a
      # literal " here would break ood_core's pod.yml.erb, which re-embeds this
      # command in another double-quoted scalar. The backslash count is doubled
      # because both templates un-escape one level. Don't reduce it untested.
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
          - "user-<%= user.name %>"
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; source /bin/create_salt_and_sha1; Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.NotebookApp.password=u${Q}sha1:${SALT}:${PASSWORD_SHA1}${Q} <%= configmap_filename %>"
      - name: "add-hostport-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/find_host_port; Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.NotebookApp.base_url=${Q}/node/${HOST_CFG}/${PORT_CFG}/${Q} <%= configmap_filename %>"